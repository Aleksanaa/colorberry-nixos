From: colorberry-nixos
Subject: [PATCH] sharp-drm: port to Linux 6.18 APIs

SPDX-License-Identifier: GPL-2.0-or-later

The driver targets the 6.1 Allwinner BSP kernel. Five things changed
between that and 6.18:

 * drm_fb_xrgb8888_to_gray8()/_to_rgb888() take a struct
   drm_format_conv_state since 6.8.
 * drm_fbdev_generic_setup() was replaced by the fbdev_probe driver hook
   plus drm_client_setup(), and drm_fbdev_generic.h is gone.
 * struct drm_driver lost its date field in 6.14.
 * fb_create() and drm_gem_fb_create_with_dirty() take a struct
   drm_format_info.
 * from_timer() and del_timer_sync() were renamed to
   timer_container_of() and timer_delete_sync().

The conversion state is file scope rather than per call: both call sites
already share panel->buf, so the update path is serialised regardless.
--- a/src/drm_iface.c
+++ b/src/drm_iface.c
@@ -33,9 +33,8 @@
 #include <drm/drm_probe_helper.h>
 #include <drm/drm_simple_kms_helper.h>
 
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
-#include <drm/drm_fbdev_generic.h>
-#endif
+#include <drm/clients/drm_client_setup.h>
+#include <drm/drm_fbdev_dma.h>
 
 #include "params_iface.h"
 #include "ioctl_iface.h"
@@ -47,6 +46,9 @@
 
 // Globals
 
+// Shared like panel->buf: the display update path is serialised.
+static struct drm_format_conv_state sharp_fmtcnv_state = DRM_FORMAT_CONV_STATE_INIT;
+
 struct overlay_storage_t
 {
 	struct list_head list;
@@ -137,7 +139,7 @@
 {
 	static u8 vcom_setting = 0;
 
-	struct sharp_memory_panel *panel = from_timer(panel, t, vcom_timer);
+	struct sharp_memory_panel *panel = timer_container_of(panel, t, vcom_timer);
 
 	// // Toggle the GPIO pin
 	gpiod_set_value(panel->gpio_vcom, 1);
@@ -422,7 +424,7 @@
 	iosys_map_set_vaddr(&dst, buf);
 	iosys_map_set_vaddr(&vmap, dma_obj->vaddr);
 	// DMA `clip` into `buf` and convert to 8-bit grayscale
-	drm_fb_xrgb8888_to_gray8(&dst, NULL, &vmap, fb, clip);
+	drm_fb_xrgb8888_to_gray8(&dst, NULL, &vmap, fb, clip, &sharp_fmtcnv_state);
 
 	// End DMA area
 	drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
@@ -650,7 +652,7 @@
 	iosys_map_set_vaddr(&dst, buf);
 	iosys_map_set_vaddr(&vmap, dma_obj->vaddr);
 	// DMA `clip` into `buf` and convert to 8-bit grayscale
-	drm_fb_xrgb8888_to_rgb888(&dst, NULL, &vmap, fb, clip);
+	drm_fb_xrgb8888_to_rgb888(&dst, NULL, &vmap, fb, clip, &sharp_fmtcnv_state);
 
 	// End DMA area
 	drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
@@ -799,7 +801,7 @@
 	spi = panel->spi;
 
 	// Cancel the timer
-	del_timer_sync(&panel->vcom_timer);
+	timer_delete_sync(&panel->vcom_timer);
 
 	power_off(panel);
 }
@@ -836,13 +838,14 @@
 }
 
 static struct drm_framebuffer *create_and_store_fb(struct drm_device *dev,
-												   struct drm_file *file, const struct drm_mode_fb_cmd2 *mode_cmd)
+												   struct drm_file *file, const struct drm_format_info *info,
+												   const struct drm_mode_fb_cmd2 *mode_cmd)
 {
 	struct sharp_memory_panel *panel;
 
 	// Initialize framebuffer
 	panel = drm_to_panel(dev);
-	panel->fb = drm_gem_fb_create_with_dirty(dev, file, mode_cmd);
+	panel->fb = drm_gem_fb_create_with_dirty(dev, file, info, mode_cmd);
 	return panel->fb;
 }
 
@@ -886,9 +889,9 @@
 	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
 	.fops = &sharp_memory_fops,
 	DRM_GEM_DMA_DRIVER_OPS_VMAP,
+	DRM_FBDEV_DMA_DRIVER_OPS,
 	.name = "sharp_drm",
 	.desc = "Sharp Memory LCD panel",
-	.date = "20230713",
 	.major = 1,
 	.minor = 1,
 
@@ -1014,7 +1017,7 @@
 
 	// fbdev setup
 	spi_set_drvdata(spi, drm);
-	drm_fbdev_generic_setup(drm, 0);
+	drm_client_setup(drm, NULL);
 
 	printk(KERN_INFO "sharp_memory: successful probe\n");
 
