+
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Keyboard Driver for Blackberry Keyboards BBQ10 from arturo182. Software written by wallComputer.
+ */
+
+int power_supply_iface_probe(struct i2c_client* i2c_client);
+
+#endif
diff --git a/src/sysfs_iface.c b/src/sysfs_iface.c
index c41a07b..a496407 100644
--- a/src/sysfs_iface.c
+++ b/src/sysfs_iface.c
@@ -20,7 +20,7 @@
 #include "sysfs_iface.h"
 
 // Read battery level over I2C
-static int read_raw_battery_level(void)
+int read_raw_battery_level(void)
 {
 	int rc;
 	uint8_t battery_level[2];
diff --git a/src/sysfs_iface.h b/src/sysfs_iface.h
index b037fdb..9c74ce3 100644
--- a/src/sysfs_iface.h
+++ b/src/sysfs_iface.h
@@ -6,6 +6,8 @@
